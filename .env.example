# Copie este arquivo para ".env" (que NÃO vai para o Git) e preencha os valores.
# Aqui ficam só os NOMES das variáveis. Nunca escreva usuário/senha neste arquivo.

# URL JDBC do Oracle (formato: jdbc:oracle:thin:@servidor:porta:sid)
DB_URL=
# Usuário do banco
DB_USER=
# Senha do banco
DB_PASSWORD=

# URL do front-end publicado (liberada no CORS). Opcional em desenvolvimento.
FRONT_URL=

# Porta da API. Opcional (padrão 8080). No Render ela é definida automaticamente.
PORT=
