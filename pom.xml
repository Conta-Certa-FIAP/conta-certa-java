<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- O "parent" do Spring Boot define as versões compatíveis de todas as bibliotecas,
         por isso quase nenhuma dependência abaixo precisa informar <version>. -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>br.com.fiap</groupId>
    <artifactId>conta-certa-api</artifactId>
    <version>1.0.0</version>
    <name>conta-certa-api</name>
    <description>API REST Java do Conta Certa - Global Solution FIAP 2026/2</description>

    <properties>
        <java.version>21</java.version>
        <modelmapper.version>3.2.8</modelmapper.version>
    </properties>

    <dependencies>
        <!-- Spring MVC + Tomcat embutido + Jackson (JSON): é o que faz a API REST existir -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Bean Validation (@NotBlank, @Email, @Valid...).
             Traz o "Hibernate Validator", que é só o validador de campos.
             NÃO é o Hibernate ORM / JPA (esses são proibidos e não estão neste projeto). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- JDBC puro: entrega o DataSource (pool de conexões HikariCP) configurado
             pelo application.properties. NÃO é Spring Data: todo o SQL é escrito
             à mão nos DAOs, com PreparedStatement. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>

        <!-- Driver do Oracle -->
        <dependency>
            <groupId>com.oracle.database.jdbc</groupId>
            <artifactId>ojdbc11</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Converte DTO <-> model sem escrever getter/setter na mão -->
        <dependency>
            <groupId>org.modelmapper</groupId>
            <artifactId>modelmapper</artifactId>
            <version>${modelmapper.version}</version>
        </dependency>

        <!-- Só a parte de criptografia do Spring Security (BCrypt para a senha).
             De propósito NÃO usamos o spring-boot-starter-security, que bloquearia todas as rotas. -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>

        <!-- JUnit 5 para os testes unitários -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>conta-certa-api</finalName>
        <resources>
            <!-- Os recursos normais (application.properties) -->
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <!-- Os scripts do banco vão para dentro do .jar (pasta db/): a classe MigracaoBanco
                 os usa para criar ou atualizar as tabelas sozinha quando a API sobe. -->
            <resource>
                <directory>database</directory>
                <targetPath>db</targetPath>
                <includes>
                    <include>*.sql</include>
                </includes>
            </resource>
        </resources>
        <plugins>
            <!-- Gera o .jar executável (java -jar target/conta-certa-api.jar) -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
